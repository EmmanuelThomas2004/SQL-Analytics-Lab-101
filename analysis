CREATE DATABASE sql_analytics_lab;
 
-- USE DATABASE
USE sql_analytics_lab;
 
-- CREATE TABLE
CREATE TABLE employees (
emp_id INT PRIMARY KEY,
emp_name VARCHAR(50),
department VARCHAR(50),
salary DECIMAL(10,2),
city VARCHAR(50),
joining_date DATE
);
 
