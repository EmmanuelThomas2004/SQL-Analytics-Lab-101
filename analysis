10 SQL Queries
1. View All Records
SQL
SELECT * FROM employees;
2. Employees in IT Department
SQL
SELECT *
FROM employees
WHERE department = 'IT';
3. Salary Greater Than 60000
SQL
SELECT emp_name, salary
FROM employees
WHERE salary > 60000;
4. Sort Salary Descending
SQL
SELECT emp_name, salary
FROM employees
ORDER BY salary DESC;
5. Count Total Employees
SQL
SELECT COUNT(*) AS total_employees
FROM employees;
6. Average Salary by Department
SQL
SELECT department, AVG(salary) AS avg_salary
FROM employees
GROUP BY department;
7. Highest Salary
SQL
SELECT MAX(salary) AS highest_salary
FROM employees;
8. Employees Joined After 2021
SQL
SELECT emp_name, joining_date
FROM employees
WHERE joining_date > '2021-12-31';
9. Total Salary by City
SQL
SELECT city, SUM(salary) AS total_salary
FROM employees
GROUP BY city;
10. Departments Having More Than One Employee
SQL
SELECT department, COUNT(*) AS employee_count
FROM employees
GROUP BY department
HAVING COUNT(*) > 1;
